#version 450
// ============================================================
// sky_cube.comp —— 把程序化天空烘焙进一张立方体贴图
//
// 这是整个 IBL 链的**源头**：irradiance（漫反射）与 prefilter（镜面）
// 两条卷积都只读这张图。天空模型只有一份，在 sky_model.glsl 的
// `vennSkyRadiance()` 里 —— 与背景 pass（sky.frag）逐字共用。
//
// 2026-11-01：参数从"天顶色 + 地面色"两个 vec4 扩成完整的
// SkyParams（8 个 vec4，128 字节），云 / 星 / 太阳一并烘进来。
// 于是"晴天改成夜晚"时，球面反射里的天空也跟着变暗、跟着出现星点 ——
// 这正是同一份参数走同一条公式的好处。
//
// 为什么用 compute 而不是"渲染 6 个面"：
//   面号 → 方向是一张纯查表函数（vennCubeDir），一趟 compute 就能
//   把 6 个面写满，不需要 6 个 Framebuffer、6 次 RenderPass，
//   也没有光栅化 / 深度 / 视口状态要配。
//
// 线程布局：一个 invocation 写一个像素。
//   x, y = 面内像素；z = 面号（dispatch 的 z 维 = 6）
//
// ⚠ `#include` 放在 local_size 声明**之后**：compute 的 local_size
//   必须在其它声明之前出现，而 #include 是纯文本展开。
// ============================================================

layout(local_size_x = 8, local_size_y = 8) in;

// 输出：整个立方体（Vulkan 里立方体就是 6 层的 2D 数组）
layout(set = 0, binding = 0, rgba32f) uniform writeonly image2DArray skyOut;

#include "sky_model.glsl"

void main() {
    const int face = int(gl_GlobalInvocationID.z);
    if (face >= 6) return;

    const ivec2 size = imageSize(skyOut).xy;
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    const vec3 dir = vennCubeDir(face, vennCubeFaceUv(pixel, size));
    imageStore(skyOut, ivec3(pixel, face), vec4(vennSkyRadiance(dir), 1.0));
}

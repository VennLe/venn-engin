#version 450
// ============================================================
// fog_inject.comp —— Froxel 体积雾第一趟：属性 + 单位长度内散射
//
// 一个 invocation 负责一个 froxel。froxel 网格：
//   x/y = 屏幕切成 froxelX × froxelY 的瓦片（比像素粗）
//   z   = 视图空间深度上的指数分层（froxelZ 层，近密远疏）
//
// 每个 froxel：
//   1. 反投影出视锥小块（8 角点 → 世界 AABB）
//   2. 采样深度决定该格被几何占据的比例（截断积分）
//   3. 遍历与 AABB 相交的灯 + 太阳，求单位长度的内散射/消光
//
// set 0 = 全局集（FrameUBO + lights[] SSBO，与分簇共用同一份）
// set 1 = 本模块私有：深度图 + storage image（fogScatter）
// ============================================================

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// 与 C++ 端 render/RenderTypes.h 的 FrameUBO 严格对应（std140）。
// 只声明到本趟用得到的成员为止 —— 偏移与 pbr.frag 逐字段一致。
layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view;
    mat4 proj;
    vec4 lightDir;
    vec4 lightColor;
    vec4 camPos;
    mat4 lightSpace[4];
    vec4 cameraParams;  // x=zNear y=zFar z=切片最近深度 w=切片数
    vec4 clusterDims;   // x=gridX y=gridY z=depthSlices w=tileSize
    vec4 screenSize;    // x=width y=height z=1/width w=1/height
    vec4 lightParams;   // x=灯数
    mat4 invViewProj;
} ubo;

struct Light {
    vec4 positionRange;      // xyz=世界坐标 w=影响半径
    vec4 colorIntensity;     // rgb=颜色  a=强度
    vec4 directionCosInner;  // xyz=传播方向 w=cos(内锥角)
    vec4 cosOuterType;       // x=cos(外锥角) y=类型(0=点 1=射灯)
};

layout(std430, set = 0, binding = 2) readonly buffer LightBuffer {
    Light lights[];
};

// set 1：深度图（最近邻整点取）+ 读写 froxel 3D 图（GENERAL 布局）
// 深度图在 MSAA=4 时是 sampler2DMS、MSAA=1 时是 sampler2D —— 与 SSAO
// 同款双形态（同一份源码两个宏编出）。本趟只取 sample 0（体积雾不需要
// 逐样本精度，只要"这一格有没有被表面挡住"）。
#ifndef VENN_MSAA_DEPTH
#define VENN_MSAA_DEPTH 0
#endif
#if VENN_MSAA_DEPTH
layout(set = 1, binding = 0) uniform sampler2DMS uDepth;
#else
layout(set = 1, binding = 0) uniform sampler2D uDepth;
#endif
layout(set = 1, binding = 1, rgba16f) uniform image3D fogScatter;

layout(push_constant) uniform Push {
    uvec4 grid;    // x=froxelX y=froxelY z=froxelZ w=flags
    vec4 params;   // x=密度 y=散射反照率 z=高度衰减 w=雾团强度
    vec4 params2;  // x=切片最近深度 y=zNear z=zFar w=相位 g
} pc;

// NDC z（[-1,1]）→ 视图空间深度 d
float ndcToViewDepth(float z, float zn, float zf) {
    return (2.0 * zn * zf) / ((zn + zf) - z * (zf - zn));
}

bool sphereIntersectsAabb(vec3 c, float r, vec3 mn, vec3 mx) {
    vec3 closest = clamp(c, mn, mx);
    vec3 d = c - closest;
    return dot(d, d) <= r * r;
}

float hgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * 3.14159265 * pow(max(denom, 1e-4), 1.5));
}

void main() {
    const uvec3 gid = gl_GlobalInvocationID;
    if (gid.x >= pc.grid.x || gid.y >= pc.grid.y || gid.z >= pc.grid.z) return;

    const float zn = pc.params2.y;
    const float zf = pc.params2.z;
    const float sliceNear = pc.params2.x;
    const float slices = float(pc.grid.z);

    const float x0 = -1.0 + 2.0 * float(gid.x) / float(pc.grid.x);
    const float x1 = -1.0 + 2.0 * float(gid.x + 1u) / float(pc.grid.x);
    const float y0 = -1.0 + 2.0 * float(gid.y) / float(pc.grid.y);
    const float y1 = -1.0 + 2.0 * float(gid.y + 1u) / float(pc.grid.y);

    // 指数分层：d(k) = sliceNear · (zf/sliceNear)^(k/slices)
    const float ratio = zf / sliceNear;
    const float dn = sliceNear * pow(ratio, float(gid.z) / slices);
    const float df = sliceNear * pow(ratio, float(gid.z + 1u) / slices);
    const float zn0 = (zf + zn) / (zf - zn) - (2.0 * zf * zn) / ((zf - zn) * dn);
    const float zn1 = (zf + zn) / (zf - zn) - (2.0 * zf * zn) / ((zf - zn) * df);

    // 反投影 8 角点得世界 AABB
    vec3 mn = vec3(1e30);
    vec3 mx = vec3(-1e30);
    for (int ci = 0; ci < 4; ++ci) {
        const float nx = (ci & 1) == 0 ? x0 : x1;
        const float ny = (ci & 2) == 0 ? y0 : y1;
        for (int ck = 0; ck < 2; ++ck) {
            const float nz = (ck == 0) ? zn0 : zn1;
            vec4 wp = ubo.invViewProj * vec4(nx, ny, nz, 1.0);
            vec3 w = wp.xyz / wp.w;
            mn = min(mn, w);
            mx = max(mx, w);
        }
    }
    const vec3 center = 0.5 * (mn + mx);

    // 介质密度：基础密度 × 高度衰减 × 局部雾团
    const float h = center.z;
    const float heightAtten = exp(-max(h, 0.0) * pc.params.z);
    float blob = 0.0;
    {
        vec3 b0 = vec3(0.0, 0.0, 2.0);
        vec3 b1 = vec3(-6.0, 4.0, 5.0);
        blob += exp(-3.0 * dot(center - b0, center - b0));
        blob += 0.7 * exp(-2.0 * dot(center - b1, center - b1));
    }
    const float density =
        pc.params.x * heightAtten * (1.0 + pc.params.w * blob);

    // 深度截断：这一格被几何占据的比例
    float coverage = 1.0;
    {
#if VENN_MSAA_DEPTH
        ivec2 dsize = textureSize(uDepth);  // sampler2DMS 无 lod 参数
#else
        ivec2 dsize = textureSize(uDepth, 0);
#endif
        ivec2 px = ivec2(vec2((float(gid.x) + 0.5) / float(pc.grid.x),
                              (float(gid.y) + 0.5) / float(pc.grid.y)) *
                         vec2(dsize));
        px = clamp(px, ivec2(0), dsize - ivec2(1));
        float dSurface = texelFetch(uDepth, px, 0).r;
        float dView = ndcToViewDepth(dSurface * 2.0 - 1.0, zn, zf);
        if (dView <= dn) {
            coverage = 0.0;
        } else if (dView < df) {
            coverage = (dView - dn) / max(df - dn, 1e-5);
        }
    }

    // 内散射：遍历 AABB 内的灯
    const vec3 cam = ubo.camPos.xyz;
    vec3 inscatter = vec3(0.0);
    const uint lightCount = uint(ubo.lightParams.x);
    for (uint i = 0u; i < lightCount; ++i) {
        const vec3 lp = lights[i].positionRange.xyz;
        const float r = lights[i].positionRange.w;
        if (r <= 0.0) continue;
        if (!sphereIntersectsAabb(lp, r, mn, mx)) continue;

        vec3 toFroxel = center - lp;
        float dist = length(toFroxel);
        if (dist < 1e-4) dist = 1e-4;

        float atten = 1.0;
        const int type = int(lights[i].cosOuterType.y + 0.5);
        if (type == 1) {
            float cosOuter = lights[i].cosOuterType.x;
            float cosInner = lights[i].directionCosInner.w;
            vec3 ldir = normalize(lights[i].directionCosInner.xyz);
            float cosT = dot(normalize(-toFroxel), ldir);
            atten = clamp((cosT - cosOuter) / max(cosInner - cosOuter, 1e-4),
                          0.0, 1.0);
            atten *= atten;
        }
        float win = clamp(1.0 - dist / r, 0.0, 1.0);
        float falloff = win * win / (1.0 + dist * dist);
        if (atten <= 0.0 || falloff <= 0.0) continue;

        vec3 radiance = lights[i].colorIntensity.rgb *
                        lights[i].colorIntensity.a;
        vec3 wLight = normalize(lp - center);
        vec3 wView = normalize(cam - center);
        float cosTheta = dot(wLight, wView);
        float phase = hgPhase(cosTheta, pc.params2.w);
        inscatter += radiance * atten * falloff * phase;
    }

    // 太阳（方向光）：God ray 的主要来源
    {
        vec3 wLight = -normalize(ubo.lightDir.xyz);
        vec3 wView = normalize(cam - center);
        float phase = hgPhase(dot(wLight, wView), pc.params2.w);
        inscatter += ubo.lightColor.rgb * ubo.lightColor.a * phase * 0.5;
    }

    vec3 scatter = inscatter * density * pc.params.y * coverage;
    float extinct = density * coverage;

    imageStore(fogScatter, ivec3(gid), vec4(scatter, extinct));
}

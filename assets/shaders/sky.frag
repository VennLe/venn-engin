#version 450
// ============================================================
// sky.frag —— 天空盒背景（片元实时求值）
//
// 本文件现在只做一件事：把视线方向交给 sky_model.glsl 的
// `vennSkyRadiance()`。所有参数（颜色 / 云 / 星 / 太阳）都从
// push constant 来，由 Sky & Atmosphere 面板在运行时写。
//
// ---- 为什么从"采样立方体贴图"改成"实时算" ----
//   以前这里是 `texture(skyMap, dir)`，天空由 sky_cube.comp 烘一张
//   128² 立方体。改成实时算之后：
//     · 面板拖动滑条**立刻**见效，不需要重烘 IBL（重烘要几十毫秒，
//       拖动时是一卡一卡的）；
//     · 云边与星点按像素中心求值，没有立方体分辨率的台阶；
//     · 与烘焙路径读**同一个函数、同一份参数**，一致性由"只有一处
//       公式"保证 —— 这比"只有一份数据"更强（数据会过期，代码不会）。
//   立方体仍然要烘，但它只服务 IBL / 反射，不再服务背景。
//
// ---- 为什么不是"背景用一套、烘焙用另一套" ----
//   那样一改天顶色，背景变了而球面反射没变（或反过来），
//   是最难查的那类不一致。共享 sky_model.glsl 把这类漂移从
//   "靠人记住"变成"编译期只有一处"。
// ============================================================

layout(location = 0) in vec3 vDir;
layout(location = 0) out vec4 outColor;

#include "sky_model.glsl"

void main() {
    // 已经是 HDR 线性值，直接写进 HDR 目标，交给后处理做 tonemap。
    // 不做 clamp —— 太阳盘亮度 > 1 正是 bloom 的来源。
    outColor = vec4(vennSkyRadiance(vDir), 1.0);
}

# 构建产物
build/
build-*/
out/
bin/
dist/                  # make package 产出的发布包

# 编译中间物
*.o
*.obj
*.a
*.lib
*.exe
*.spv

# 着色器编译输出（保留源码，spv 由构建生成）
assets/shaders/*.spv

# IDE
.vs/
.idea/
*.user
# .vscode：忽略临时文件，但保留 IntelliSense / CMake 配置（对项目可复现性至关重要）
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
!.vscode/extensions.json
CMakeUserPresets.json
compile_commands.json
.cache/

# 运行时写出的界面状态（ImGui 窗口布局，路径跟着进程的工作目录走）
imgui.ini

# 运行期配置（E03 设置层级）。仓库里只留 config/README.md 与
# render.example.json ——**用户自己的覆盖**不该进版本控制。
# 正常跑起来这些文件落在 build/bin/config/（已被上面的 build/ 忽略），
# 这两条是防"从仓库根目录启动编辑器"时把个人设置提上去。
/config/render.json
/config/render_prefs.json
/config/editor_layout.json
/config/editor_prefs.json

# 截图工具（tools/capture_window.py）的默认输出落在仓库根目录。
# 只忽略根目录的 png，assets/ 下的贴图不受影响。
/*.png

# G14-6 流式对照用的 10 分钟 wav（105 MB）。
# 正常情况下它只生成到 build/bin/assets/audio/（已被 build/ 忽略），
# 这条是兜底：谁不小心用 --long 指到 assets/audio/ 也不会提交进去。
# 缺了它 `verify_audio.py` 会自动重新生成（见 gen_long_audio），
# 只是那一次的 A5 组对照会被跳过。
assets/audio/_long_*.wav

# 系统杂项
.DS_Store
Thumbs.db
_*.txt

# Python 字节码缓存：tools/*.py 每跑一次验收就会生成一份，
# 进 git status 只是噪音（2026-10-28 清三件时顺手补的）。
__pycache__/
*.py[cod]

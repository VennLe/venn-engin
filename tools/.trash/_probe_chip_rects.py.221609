"""临时探针：抓一次 1600x1220 会话的 CONTENT-DRAWER / MAT-SLOT 矩形。

只为查清 "材质槽拖放收不到" 是几何遮挡还是 DnD 载荷失效：
若抽屉矩形覆盖材质槽，则落点被抽屉吃掉（产品问题）；
若抽屉不在，则是载荷问题。
"""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from capture_window import find_window, user32          # noqa: E402
from verify_add_menu import LogTap                      # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
EXE = os.path.join(ROOT, "build", "bin", "Editor.exe")


def main():
    env = dict(os.environ)
    env["MYVK_LOG_RECTS"] = "1"
    env["MYVK_NO_WINDOW_SAVE"] = "1"
    env["MYVK_CONTENT_DIR"] = "assets/models/Cube"
    env["MYVK_EDITOR_SELECT"] = "Ground"
    proc = subprocess.Popen([EXE], cwd=os.path.dirname(EXE), env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, encoding="utf-8", errors="replace",
                            bufsize=1)
    tap = LogTap()
    tap.start(proc)
    try:
        hwnd = find_window("Venn Editor")
        if not hwnd:
            print("no window")
            return 2
        user32.ShowWindow(hwnd, 9)
        time.sleep(2.0)
        user32.SetWindowPos(hwnd, 0, 0, 0, 1600, 1220, 0x0002 | 0x0004)
        time.sleep(3.0)
        with tap.lock:
            lines = list(tap.lines)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=8)
        except subprocess.TimeoutExpired:
            proc.kill()

    interesting = ("CONTENT-DRAWER", "MAT-SLOT", "CB-CELL", "VP-RECT",
                   "INS-MESH-HEADER", "MAT-CHIP")
    seen = set()
    for ln in lines:
        if any(k in ln for k in interesting):
            if ln in seen:
                continue
            seen.add(ln)
            print(ln.rstrip())
    return 0


if __name__ == "__main__":
    sys.exit(main())

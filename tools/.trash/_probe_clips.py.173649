"""临时探针 2：四段 clip 各拍一张，看哪一段的姿势是"正常的人形"。

背景：`Idle` 在 `time=0` 时整个身体会被拉成细长尖刺（10-19 的
`char_import_edit.png` 也是这个现象，同一天 `anim.clip Walk;anim.time 0.6`
却是正常 chibi）。所以先确认到底哪几段 clip 的数据是好的，再决定
"底座 / 上层"用哪两段。
"""

import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from capture_window import capture_client, find_window, user32          # noqa: E402
from verify_add_menu import LogTap, wait_rect                            # noqa: E402
from verify_shader_variants import OUT_DIR, ROOT                         # noqa: E402

EXE = os.path.join(ROOT, "build", "bin", "Editor.exe")
TPL = os.path.join(OUT_DIR, "anim_layers_tpl.json")
CAM = "1.60,-1.60,0.95,45,12"


def make(tag, clip, t):
    with open(TPL, encoding="utf-8") as f:
        doc = json.load(f)
    for e in doc["entities"]:
        if e.get("skinned"):
            e["skinned"]["clipName"] = clip
            e["skinned"]["time"] = t
            e["skinned"]["playing"] = False
    p = os.path.join(OUT_DIR, "probe2_%s.json" % tag)
    with open(p, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1)
    return p


def shot(tag, scene):
    env = dict(os.environ)
    env.update({
        "MYVK_EDITOR_SCENE": scene,
        "MYVK_EDITOR_CAM": CAM,
        "MYVK_EDITOR_NO_HUD": "1",
        "MYVK_NO_WINDOW_SAVE": "1",
        "MYVK_GRID": "0", "MYVK_TAA": "0", "MYVK_SHADOW": "0",
        "MYVK_LOG_RECTS": "1",
    })
    p = subprocess.Popen([EXE], cwd=os.path.dirname(EXE), env=env,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, encoding="utf-8", errors="replace",
                         bufsize=1)
    tap = LogTap()
    tap.start(p)
    hwnd = find_window("Venn Editor")
    if not hwnd:
        print("FAIL window", tag)
        return
    user32.ShowWindow(hwnd, 9)
    time.sleep(1.5)
    user32.SetWindowPos(hwnd, 0, 0, 0, 1280, 800, 0x0002 | 0x0004)
    time.sleep(2.5)
    wait_rect(tap, "VP-RECT", 12.0)
    end = time.time() + 20
    while time.time() < end:
        with tap.lock:
            n = sum(1 for l in tap.lines if "ANIM-TICK " in l)
        if n >= 2:
            break
        time.sleep(0.25)
    time.sleep(1.4)
    img, ok = capture_client(hwnd)
    if ok and img is not None:
        img.save(os.path.join(OUT_DIR, "probe2_%s.png" % tag))
        print("shot", tag)
    with tap.lock:
        for l in tap.lines:
            if "MODEL-CLIPS" in l or "CLIP" in l and "ANIM" in l:
                print("   ", l.rstrip()[:160])
    try:
        user32.PostMessageW(hwnd, 0x0010, 0, 0)
    except Exception:
        pass
    time.sleep(0.4)
    if p.poll() is None:
        p.terminate()


def main():
    jobs = [("idle", "Idle", 0.5), ("walk", "Walk", 0.5),
            ("rigidle", "Rig|Idle", 0.5), ("rigwalk", "Rig|Walk", 0.5)]
    for tag, clip, t in jobs:
        shot(tag, make(tag, clip, t))
    return 0


if __name__ == "__main__":
    sys.exit(main())

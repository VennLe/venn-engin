    "柔和卡通。只影响第一道边界 ——\n"
    "里面的档位保持硬，否则脸就糊了。",
    "面部 SDF 图把一个面部纹素推进阴影档的强度。\n"
    "需要在 Sdf 纹理槽里放一张\n"
    "UV 是正面脸部展开的图。",
    "光转动时 SDF 采样点滑动多远。\n"
    "0 = 图怎么画就怎么显示（固定机位人像）；\n"
    "0.15 = 常规；>0.3 = 图只提供形状。",
    "用专门的角色光而不是场景光来照这个材质：\n"
    "一盏主光加一层平的环境色。这能让二次元的脸\n"
    "在树荫下不发绿，\n"
    "在黄昏不发橙。\n\n"
    "副作用：跳过 CSM 阴影（它们的 PCF 台阶\n"
    "在赛璐璐脸上看得见）。两者只能选一个。\n\n"
    "灯本身在 渲染 > 角色光 里调。",
    "跨材质的绘制顺序。小的先画 = 在下面。\n"
    "跨越档位时完全忽略距离；同一档内\n"
    "仍按常规的由远到近排。\n\n"
    "建议档位（只是起点，不是规矩）：\n"
    "  1900 天空    2000 身体/布料   2400 脸部皮肤\n"
    "  2900 后发   3000 前发   3100 眼白+虹膜\n"
    "  3200 睫毛   3300 眉毛   3400 腮红/贴花\n\n"
    "注意眼睛必须在前发之上：二次元的眼睛总是画在\n"
    "刘海上面，这件事任何几何排序都表达不了。\n\n"
    ">= 3000 进入叠加档：关深度测试、不写深度。\n"
    "因为二次元的眼睛凹在眼窝里，\n"
    "跟脸抢深度必输。",
    "同一个渲染队列内的次序。抬高它可以把\n"
    "同一队列里的某个部件提到另一个之上。",
    "一条\"相机关键帧 + 事件\"的时间轴，存在\n"
    "assets/sequences/*.seq.json。挂到一个\n"
    "空物体上，把那个物体当导演用。",
    "对话",
    "一份 .dlg.json 剧本：说话人 / 正文 / 选项。\n"
    "挂在 NPC 上，或者挂在导演物体上\n"
    "由时间轴 cue 它（kind=Line）。",
    "从选中项创建预制体",
    "删除 %zu 个对象",
    " 个对象",
    "选中： ",
]

LINE_RE = re.compile(r'^\{"((?:[^"\\]|\\.)*)"')
PH_RE = re.compile(r"%[-+ 0#0-9.*hlLjzt]*[a-zA-Z]")


def placeholders(s):
    return sorted(PH_RE.findall(s)), s.count("\n")


def cpp_lit(s):
    out = []
    for ch in s:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def main():
    raw_keys = []
    for line in open(DUMP, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        m = LINE_RE.match(line)
        if not m:
            print("!! 解析不了这一行：", line[:70])
            return 1
        raw_keys.append(m.group(1))

    print("dump keys = %d, 中文 = %d" % (len(raw_keys), len(ZH)))
    if len(raw_keys) != len(ZH):
        print("!! 条数不等，先核对顺序")
        return 1

    table = open(TABLE, encoding="utf-8").read()
    existing = set(re.findall(r'^\s*\{"((?:[^"\\]|\\.)*)"', table, re.M))
    entries, problems = [], []
    for i, (raw, zh) in enumerate(zip(raw_keys, ZH)):
        en = ast.literal_eval('"' + raw + '"')
        a, b = placeholders(en), placeholders(zh)
        if a != b:
            problems.append("  [%d] 占位符不一致 EN=%s ZH=%s  %r"
                            % (i, a, b, en[:50]))
        lit = "{" + cpp_lit(en) + ", " + cpp_lit(zh) + "},"
        if raw in existing:
            problems.append("  [%d] 词典里已有同名键：%r" % (i, en[:50]))
        entries.append(lit)

    for en, zh in A1:
        lit = "{" + cpp_lit(en) + ", " + cpp_lit(zh) + "},"
        if en in existing:
            problems.append("  A1 词典里已有：%r" % en)
        entries.append(lit)

    if problems:
        print("!! 中止，%d 个问题：" % len(problems))
        for p in problems:
            print(p)
        return 1

    block = ("\n    // ===== 2026-10-27：Prefab / 动画挂件 / 对话 / 多选 /"
             " 卡通材质 / 描边 这批新面板的文案 =====\n"
             "    // 之前这些面板只有英文上屏（TR 包了但词典没有条目）。\n"
             "    // i18n 体检的 B2 组 95 条 + A1 组 5 条。\n"
             + "\n".join("    " + e for e in entries) + "\n")
    # 追加到 kZh[] 的收尾 `};` 之前
    idx = table.rfind("};")
    if idx < 0:
        print("!! 找不到表尾 };")
        return 1
    table = table[:idx] + block + table[idx:]
    open(TABLE, "w", encoding="utf-8", newline="\n").write(table)
    print("已写入 %d 条（B2 %d + A1 %d）" % (len(entries),
                                            len(raw_keys), len(A1)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np

from verify_toon_shading import (BALL_POS, BALL_SIZE, LIGHT_DIR, OUT_DIR, SUN,
                                 center_patch, entity, luma, material_model,
                                 run_once, to_np_rgb, write_scene)

EXE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                   "build", "bin", "Editor.exe")
ENV = {"MYVK_SHADER_VARIANTS": "1", "MYVK_GRID": "0", "MYVK_BINDLESS": "1"}


def shot(tag, tex, ramp=None, strength=1.0):
    sc = os.path.join(OUT_DIR, "diag2_%s.json" % tag)
    mat = material_model("diag2_%s" % tag, "toon")
    if ramp:
        mat["rampPath"] = ramp
        mat["rampSteps"] = 0.0
    if tex:
        mat["sdfShadowMap"] = tex
    mat["sdfShadowStrength"] = strength
    mat["sdfFaceShift"] = 0.15
    write_scene(sc, [entity("Ball", BALL_POS,
                            {"shape": "sphere", "size": BALL_SIZE,
                             "name": "diag2_ball_%s" % tag}, mat)],
                "diag", sun=SUN, light_dir=LIGHT_DIR)
    p = os.path.join(OUT_DIR, "diag2_%s.png" % tag)
    lines, vp, img, errs = run_once(EXE, sc, ENV, p)
    if img is None:
        print(tag, "no image; errs=", errs[:2])
        return None
    a = to_np_rgb(img)
    for frac in (0.42, 0.15):
        b = center_patch(a, vp, frac=frac)
        l = luma(b)
        rgb = b.reshape(-1, 3).mean(axis=0)
        print("%-10s f=%.2f mean=%.1f std=%.1f rgb=(%.0f,%.0f,%.0f)"
              % (tag, frac, l.mean(), l.std(), rgb[0], rgb[1], rgb[2]))
    return a


W = {"kind": "solid", "name": "d_white", "color": [255, 255, 255, 255]}
B = {"kind": "solid", "name": "d_black", "color": [0, 0, 0, 255]}
RB = "ramps/diag_rb.vramp"
WARM = "ramps/toon_warm_3step.vramp"

shot("base", None)
shot("rbW", W, ramp=RB)
shot("rbB", B, ramp=RB)
shot("rampB", B, ramp=WARM)
